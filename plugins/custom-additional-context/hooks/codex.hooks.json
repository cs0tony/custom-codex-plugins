{
  "description": "Custom Additional Context Hook - Uses standard Codex hooks format",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/user-prompt-submit-hook.js\"",
            "timeout": 1000,
            "statusMessage": "Injecting custom additional context"
          }
        ]
      }
    ]
  }
}
